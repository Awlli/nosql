<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="kz.atu.lab08.ColorDialogController"
      alignment="CENTER" prefWidth="320.0" spacing="15.0">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>
   <children>
      <Label text="Выберите цвет текста"/>
      <ColorPicker fx:id="colorPicker"/>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button defaultButton="true" onAction="#onApply" text="Применить"/>
            <Button cancelButton="true" onAction="#onCancel" text="Отмена"/>
         </children>
      </HBox>
   </children>
</VBox>
